# Copy to `.env` and fill in. docker-compose reads .env via `env_file`.

# ─── Required ────────────────────────────────────────────────────────────────

# Manager bot token from @BotFather (the host-owned bot used to onboard tenants,
# e.g. @YourPrefixRelayManagerBot).
ENV_MANAGER_BOT_TOKEN=

# Your Telegram UID (the host / super-admin). Find via @userinfobot.
ENV_HOST_UID=

# 32-byte AES-GCM key, base64-encoded. Generate with:
#   openssl rand -base64 32
# ⚠️  NEVER CHANGE — rotating this orphans every stored tenant token
#    and every friend has to /setup again from scratch.
ENV_MASTER_ENC_KEY=

# Public HTTPS URL that points at this container through your reverse proxy.
# Must start with https:// (Telegram refuses non-HTTPS webhooks). No trailing
# slash. Used to compute /wh/{botId} targets passed to setWebhook.
# Example: https://relay.example.com
ENV_PUBLIC_BASE_URL=

# Required to access /admin/* endpoints (used to register the manager bot's
# webhook on first deploy). Generate with:
#   openssl rand -hex 32
# Without this, the /admin routes return 404 unconditionally.
ENV_ADMIN_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────

# Set to `1` for structured debug logging (key=value pairs, no message bodies).
# ENV_DEBUG=1

# HTTP port the container listens on. Default 8080. If you change this, also
# update the compose `ports:` mapping.
# PORT=8080

# Directory inside the container that holds db.sqlite. Default /data. Don't
# change unless you also remap the docker-compose volume.
# DATA_DIR=/data
